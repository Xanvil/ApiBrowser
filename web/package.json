{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "scan:catalog": "node scripts/scan-catalog.mjs",
    "scan:catalog:dotnet": "dotnet run --project ../ApiExtractor -- scan-catalog",
    "predev": "npm run scan:catalog",
    "prebuild": "npm run scan:catalog",
    "dev": "vite",
    "build": "tsc -b && vite build",
